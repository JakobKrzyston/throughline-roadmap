# Copy to .env.local and fill in what you need. Every variable is optional:
# without them the app uses a local PGlite database, demo data and a fake LLM.

# Postgres connection string, e.g. from Neon. Unset: data is stored in ./.pglite.
# On Neon use the pooled (-pooler) string. `neon env pull` writes both of these.
DATABASE_URL=

# Direct (non-pooled) Neon connection string, used only by `pnpm db:migrate`. Unset: DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Where the local PGlite database lives when DATABASE_URL is unset. Defaults to ./.pglite.
PGLITE_DATA_DIR=

# Anthropic API key for the agents on your own projects. Unset: OpenRouter if set below, else sample results.
ANTHROPIC_API_KEY=

# Claude model the agents call. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=

# OpenRouter API key (https://openrouter.ai/keys). Demo projects use it, so point it at a free model:
# visitors to a public site can trigger these agents. Also used for your own projects when
# ANTHROPIC_API_KEY is unset. Unset: demo projects get sample results.
OPENROUTER_API_KEY=

# OpenRouter model ids, comma-separated in fallback order: the first is tried first and OpenRouter
# moves to the next when it is rate-limited or down. List only ":free" models to stay free.
# Defaults to free models with tool calling; see docs/DEPLOY.md to pick others.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free,liquid/lfm-2.5-2.6b:free

# GitHub App credentials (see docs/GITHUB_APP.md). Unset: repositories cannot be connected.
GITHUB_APP_ID=
# The app's private key (.pem). On one line, write line breaks as \n.
GITHUB_APP_PRIVATE_KEY=
# GitHub accounts whose repositories may be connected, comma-separated, e.g. JakobKrzyston,acme.
# Required: there is no sign-in, so this is what stops visitors importing other repositories. Unset: no repositories can be connected.
GITHUB_ALLOWED_OWNERS=
# The app's URL slug, for the "Install the GitHub App" link on the settings page.
GITHUB_APP_SLUG=
# Secret GitHub signs webhooks with. Unset: /api/github/webhook answers 503.
GITHUB_WEBHOOK_SECRET=

# "true" on a public site with no sign-in: visitors may change only demo projects, demo agents use
# OPENROUTER_API_KEY or sample results but never ANTHROPIC_API_KEY, and other projects are view-only
# (see docs/DEPLOY.md).
PUBLIC_DEPLOYMENT=

# Bearer token /api/jobs/run and /api/demo/reset require; Vercel cron sends it automatically.
# Unset: /api/jobs/run is open and /api/demo/reset refuses every request.
CRON_SECRET=
